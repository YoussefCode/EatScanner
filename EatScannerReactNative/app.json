{
  "expo": {
    "name": "EatScanner",
    "slug": "eatscanner-react-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eatscanner.reactnative",
      "infoPlist": {
        "NSCameraUsageDescription": "We gebruiken de camera voor barcode scanning en ingredientenfoto's.",
        "NSPhotoLibraryUsageDescription": "We gebruiken je fotobibliotheek om ingredientenfoto's te kiezen."
      }
    },
    "android": {
      "package": "com.eatscanner.reactnative"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
